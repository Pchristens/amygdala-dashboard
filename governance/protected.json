{
  "about": "Temple governance (SPEC v0.45). A release is trivial only if it changes at most maxLines lines, every file is on the allowlist and no file matches a protected glob. Any change to this file is itself protected.",
  "maxLines": 20,
  "protected": [
    "governance/**",
    "lib/governance.js",
    "server.js",
    "lib/visitors.js",
    "lib/bridge.js",
    "lib/nodes.js",
    "lib/keeper.js",
    "lib/steward.js",
    "lib/term.js",
    "lib/conpty.js",
    "lib/sites.js",
    "lib/temple.js",
    "lib/snapshot.js",
    "lib/bin.js",
    "lib/world.js",
    "lib/seal.js",
    "lib/isle-ghosts.js",
    "lib/audit.js",
    "lib/audit-rules.js",
    "lib/guidance.js",
    "lib/triage.js",
    "lib/conductor.js",
    "lib/usage.js",
    "lib/fleet.js",
    "lib/orders.js",
    "lib/mcp.js",
    "residents.json",
    "tools/amygdala.ps1",
    "tools/amygdala.sh",
    "tools/*keeper*",
    "tools/amygdala-node.mjs",
    "tools/amygdala-hero.ps1",
    "tools/amygdala-steward.mjs",
    "tools/amygdala-order.mjs",
    "tools/install-windows.ps1",
    "tools/setup-wsl.sh",
    "tools/conpty.cs",
    "tools/ptybridge.py",
    "tools/reset-world.mjs",
    "**/package.json",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "public/vendor/**",
    "data/**",
    ".gitignore",
    ".gitattributes"
  ],
  "allowlist": {
    "prose": ["README.md", "SPEC.md", "AGENTS.md"],
    "testsAddOnly": ["tools/test-*.mjs"],
    "anyChange": ["public/**/*.css"],
    "stringsAndComments": ["public/**/*.js", "public/**/*.html", "lib/**/*.js", "lib/**/*.html"]
  }
}
